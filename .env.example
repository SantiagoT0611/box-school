# Plantilla de variables de entorno. NO pongas valores reales aqui: copia a .env (ignorado por git).

# --- Base de datos (obligatorio) ---
DB_URL=jdbc:postgresql://localhost:5432/boxing_school
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT (obligatorio). Genera uno ejecutando la clase util.GenerateJwtSecret ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# --- Primer administrador (solo se usa si aun no existe ningun admin; clave de minimo 12 caracteres) ---
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Correo para recordatorios y codigos de registro (opcional; sin host no se envian correos) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=

# --- Negocio / despliegue (opcionales) ---
# Zona del negocio. En blanco = America/Bogota (nunca la del servidor)
APP_TIMEZONE=America/Bogota
CORS_ALLOWED_ORIGINS=http://localhost:4200
REMINDER_ENABLED=true
REMINDER_DAYS_BEFORE=2
REMINDER_CRON=0 0 8 * * *
REMINDER_DELAY_MS=1000
SWAGGER_ENABLED=false
# Detras de un proxy/balanceador: native (si no, el limite de intentos de login cuenta la IP del proxy para todos)
FORWARD_HEADERS_STRATEGY=none
# SOLO la primera vez que adoptas con Flyway una base creada antes con ddl-auto=update; luego quitar
FLYWAY_BASELINE_ON_MIGRATE=false
# Dejar VACIO en produccion. 'dev' activa Swagger publico, logs DEBUG y SQL formateado
SPRING_PROFILES_ACTIVE=
